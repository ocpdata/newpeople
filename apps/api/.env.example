PORT=4000
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=8h
APP_INVITE_SETUP_URL=http://localhost:5173/set-password
APP_PASSWORD_SETUP_TOKEN_MINUTES=1440

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM=NewPeople CRM <tu_correo@gmail.com>

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=newpeople_crm
DB_POOL_SIZE=10

# Document storage
# local_fs para filesystem local o s3_compatible para AWS S3 / R2 / MinIO / Spaces.
DOCUMENT_STORAGE_PROVIDER=s3_compatible

# Aunque el storage final sea S3, hoy se sigue usando esta ruta local como staging temporal
# para parseo multipart y procesamiento inicial.
DOCUMENT_STORAGE_LOCAL_ROOT=../../.data/documents

DOCUMENT_STORAGE_S3_BUCKET=tu-bucket-documentos
DOCUMENT_STORAGE_S3_REGION=us-east-1
DOCUMENT_STORAGE_S3_ENDPOINT=
DOCUMENT_STORAGE_S3_FORCE_PATH_STYLE=false
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=tu_access_key_id
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=tu_secret_access_key

# Limites de sesion y validacion de tipos de archivo
DOCUMENT_MAX_SESSION_FILES=8
DOCUMENT_MAX_SESSION_BYTES=125829120
DOCUMENT_MAX_AUDIO_FILES_PER_SESSION=3
DOCUMENT_MAX_AUDIO_DURATION_SECONDS_PER_FILE=1200
DOCUMENT_MAX_AUDIO_DURATION_SECONDS_PER_SESSION=2400
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/plain,message/rfc822,image/png,image/jpeg,audio/mpeg,audio/wav,audio/x-wav,audio/mp4,audio/x-m4a
