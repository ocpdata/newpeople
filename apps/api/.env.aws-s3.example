NODE_ENV=production
PORT=4000
REQUEST_BODY_LIMIT=12mb

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# App
APP_INVITE_SETUP_URL=https://tu-dominio.com/set-password
APP_BASE_URL=https://tu-dominio.com
APP_PASSWORD_SETUP_TOKEN_MINUTES=1440

# OAuth Google (opcional)
AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/oauth/google/callback
GOOGLE_MAIL_REDIRECT_URI=https://tu-dominio.com/api/auth/google-mail/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=newpeople_user
DB_PASSWORD=replace-with-db-password
DB_NAME=newpeople_crm
DB_POOL_SIZE=10

# Mail / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_de_gmail
SMTP_FROM=NewPeople CRM <tu_correo@gmail.com>

# Document storage
# Almacenamiento final en AWS S3.
DOCUMENT_STORAGE_PROVIDER=s3_compatible

# Aun se usa esta ruta local como staging temporal para multipart y procesamiento.
DOCUMENT_STORAGE_LOCAL_ROOT=/var/app/newpeople/documents

# AWS S3
DOCUMENT_STORAGE_S3_BUCKET=tu-bucket-documentos
DOCUMENT_STORAGE_S3_REGION=us-east-1
DOCUMENT_STORAGE_S3_ENDPOINT=
DOCUMENT_STORAGE_S3_FORCE_PATH_STYLE=false
DOCUMENT_STORAGE_S3_ACCESS_KEY_ID=AKIA_REPLACE_ME
DOCUMENT_STORAGE_S3_SECRET_ACCESS_KEY=replace-with-secret-access-key

# Upload limits
DOCUMENT_MAX_SESSION_FILES=8
DOCUMENT_MAX_SESSION_BYTES=125829120
DOCUMENT_MAX_AUDIO_FILES_PER_SESSION=3
DOCUMENT_MAX_AUDIO_DURATION_SECONDS_PER_FILE=1200
DOCUMENT_MAX_AUDIO_DURATION_SECONDS_PER_SESSION=2400
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.ms-excel,text/csv,text/plain,message/rfc822,image/png,image/jpeg,audio/mpeg,audio/wav,audio/x-wav,audio/mp4,audio/x-m4a

# Document processing
DOCUMENT_PROCESSING_MODE=sync
DOCUMENT_PROCESSING_POLL_INTERVAL_MS=5000
DOCUMENT_PROCESSING_MAX_ATTEMPTS=3
DOCUMENT_PROCESSING_RETRY_BASE_DELAY_MS=15000

# Quotation / branding
QUOTATION_COMPANY_LOGO_PATH=/var/app/newpeople/assets/company-logo.png
QUOTATION_COMPANY_LEGAL_NAME=Tu razon social S.A. de C.V.
QUOTATION_COMPANY_TAX_ID=RFC: REEMPLAZAR123
QUOTATION_COMPANY_ADDRESS_LINES=Calle 1 No. 123|Colonia Centro|Ciudad, Estado, CP 00000
QUOTATION_COMPANY_EMAIL=ventas@tu-dominio.com
QUOTATION_COMPANY_PHONE=+52 55 0000 0000

# AI / OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ENABLE_WEB_SEARCH=false

# Feature flags
OPPORTUNITY_STAGE_ANSWER_SUGGESTIONS_ENABLED=true

# Pruebas de seguridad con F5 DCS
XC_API_URL=
XC_API_P12_FILE=
XC_P12_PASSWORD=
XC_NAMESPACE=
XC_LB_NAME=

# Usuario de pruebas para Bot Defense y validacion autenticada de APIs.
WAF_LOGIN_EMAIL=
WAF_LOGIN_PASSWORD=

# Pruebas GET generadas desde swagger.json.
API_TEST_BASE_URL=http://127.0.0.1:4000
API_TEST_REQUEST_TIMEOUT_MS=15000
API_TEST_CONCURRENCY=4

# DDoS L7 distribuido mediante Grafana Cloud k6 (perfil fijo de hasta 150 RPS).
K6_CLOUD_TOKEN=
DOS_TARGET_URL=https://newpip.digitalvs.com/api/accounts/l7-dos-test
DOS_ALLOWED_HOSTS=newpip.digitalvs.com
DOS_LOCAL_HEALTH_URL=http://127.0.0.1:4000/health